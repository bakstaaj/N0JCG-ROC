# Cloudflare Email Sending credentials for the N0JCG ROC administrator report.
# Install outside the repository as /etc/n0jcg/admin-report.env with mode 0600.
# The sender is fixed in application code as ROC@n0jcg.com.
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_API_TOKEN=replace-with-email-sending-api-token
