# Copy to /etc/n0jcg/winlink-rms.env with mode 0600. Never commit secrets.
WINLINK_CMS_PASSWORD=CHANGE_ME
WINLINK_ADMIN_USER=CHANGE_ME
WINLINK_ADMIN_PASSWORD=CHANGE_ME

# LAN-only Winlink Express Telnet Post Office. Calls -1 and -2 are reserved for
# mobile radios, and -9 is reserved for the iPhone/APRS.fi client.
WINLINK_POST_OFFICE_ENABLED=0
WINLINK_POST_OFFICE_CALL=N0JCG-11
WINLINK_OPERATOR_NAME=REPLACE_WITH_OPERATOR_NAME

# Authorized gateway identity and location.
WINLINK_BASE_CALL=REPLACE_WITH_BASE_CALL
WINLINK_NODE_CALL=REPLACE_WITH_NODE_CALL
WINLINK_GATEWAY_CALL=REPLACE_WITH_GATEWAY_CALL
WINLINK_LOCATOR=REPLACE_WITH_GRID_SQUARE

# Fill these from the coordinated channel and installed station.
WINLINK_FREQUENCY_HZ=CHANGE_ME
WINLINK_SERVICE_HOURS=00-23
WINLINK_POWER_W=CHANGE_ME
# Height above local ground level, in feet (not elevation above sea level).
WINLINK_ANTENNA_HEIGHT_FT=CHANGE_ME
WINLINK_ANTENNA_GAIN_DBI=CHANGE_ME
WINLINK_ANTENNA_DIRECTION_DEG=0

# PTT must remain 0 until a dummy-load transmit test is authorized and ready.
WINLINK_PTT_ENABLED=0
