# Copy to /etc/n0jcg/aprs-igate.env on the ROC, set mode 0600, and keep it out of Git.
# This enables RF-to-APRS-IS forwarding only; it does not enable RF transmit.
APRS_IGATE_ENABLED=1
APRS_IGATE_SERVER=rotate.aprs2.net
APRS_IGATE_PORT=14580
APRS_IGATE_LOGIN=REPLACE_WITH_IGATE_CALL
APRS_IGATE_PASSCODE=REPLACE_WITH_APRS_IS_PASSCODE
APRS_IGATE_BEACON_ENABLED=1
APRS_IGATE_BEACON_INTERVAL=720:00
APRS_IGATE_BEACON_COMMENT=N0JCG ROC RX-only iGate 144.390 MHz https://n0jcg.com
