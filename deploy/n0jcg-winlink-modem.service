[Unit]
Description=N0JCG Winlink Dire Wolf modem
After=sound.target network.target
ConditionPathExists=/etc/n0jcg/winlink-rms-approved
ConditionPathExists=/etc/n0jcg/winlink-direwolf.conf

[Service]
Type=simple
User=n0jcg
Group=n0jcg
SupplementaryGroups=audio dialout
ExecStart=/usr/bin/direwolf -t 0 -c /etc/n0jcg/winlink-direwolf.conf
# ALSA can terminate Dire Wolf with a clean SIGHUP when the DigiRig USB
# interfaces re-enumerate.  An explicit systemctl stop still suppresses the
# restart, while this policy restores the modem after a transient USB reset.
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
