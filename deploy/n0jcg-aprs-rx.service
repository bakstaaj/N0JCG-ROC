[Unit]
Description=N0JCG APRS RTL-SDR receive-only listener
After=sound.target n0jcg-roc.service
Wants=sound.target

[Service]
Type=simple
User=n0jcg
Group=n0jcg
WorkingDirectory=/home/n0jcg/sdrdev/N0JCG-ROC
Environment=RTL_GAIN_DB=20
Environment=APRS_RTL_FREQUENCY_HZ=144390000
Environment=APRS_RTL_PPM=0
Environment=APRS_RTL_SERIAL=00014439
Environment=APRS_AUDIO_CAPTURE=1
Environment=APRS_AUDIO_CAPTURE_SECONDS=600
Environment=APRS_DIREWOLF_AUDIO_STATS_SECONDS=10
Environment=APRS_IGATE_ENABLED=0
EnvironmentFile=-/etc/n0jcg/aprs-igate.env
ExecStart=/home/n0jcg/sdrdev/N0JCG-ROC/tools/aprs_listener.sh
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
