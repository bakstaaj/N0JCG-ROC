[Unit]
Description=N0JCG LinBPQ Winlink RMS gateway
After=network-online.target n0jcg-winlink-modem.service n0jcg-vara-fm.service
Wants=network-online.target
Requires=n0jcg-winlink-modem.service
Wants=n0jcg-vara-fm.service
ConditionPathExists=/etc/n0jcg/winlink-rms-approved
ConditionPathExists=/var/lib/n0jcg-winlink/bpq32.cfg
ConditionFileIsExecutable=/opt/n0jcg/linbpq/linbpq

[Service]
Type=simple
User=n0jcg
Group=n0jcg
WorkingDirectory=/var/lib/n0jcg-winlink
StateDirectory=n0jcg-winlink
ExecStart=/opt/n0jcg/linbpq/linbpq
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/n0jcg-winlink

[Install]
WantedBy=multi-user.target
