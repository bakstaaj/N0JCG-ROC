[Unit]
Description=N0JCG Radio Operations Center
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=n0jcg
Group=n0jcg
SupplementaryGroups=systemd-journal
WorkingDirectory=/home/n0jcg/sdrdev/N0JCG-ROC
Environment=PYTHONPATH=/home/n0jcg/sdrdev/N0JCG-ROC/src
Environment=ROC_APPLICATION_SETTINGS=/var/lib/n0jcg-roc/applications.json
Environment=ROC_APRSFI_SETTINGS=/var/lib/n0jcg-roc/aprs-fi.json
Environment=ROC_APRSFI_CACHE=/var/lib/n0jcg-roc/aprs-fi-cache.json
Environment=ROC_STATION_SETTINGS=/var/lib/n0jcg-roc/station.json
Environment=ROC_ADMIN_REPORT_SETTINGS=/var/lib/n0jcg-roc/admin-report.json
Environment=ROC_ADMIN_REPORT_STATE=/var/lib/n0jcg-roc/admin-report-state.json
Environment=ROC_ADMIN_REPORT_TRIGGER=/var/lib/n0jcg-roc/admin-report-send-now.json
Environment=ROC_TELEMETRY_DB=/var/lib/n0jcg-roc/telemetry.sqlite3
EnvironmentFile=-/etc/n0jcg/operator-controls.env
EnvironmentFile=-/etc/n0jcg/admin-report.env
StateDirectory=n0jcg-roc
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/python3 -m n0jcg_roc.server --host 0.0.0.0 --port 80
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/n0jcg/sdrdev/N0JCG-ROC/runtime
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
